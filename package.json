{
  "name": "spendly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spendly/api --filter @spendly/web dev",
    "dev:web": "pnpm --filter @spendly/web dev",
    "dev:api": "pnpm --filter @spendly/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @spendly/api db:generate",
    "db:migrate": "pnpm --filter @spendly/api db:migrate",
    "db:deploy": "pnpm --filter @spendly/api db:deploy",
    "db:seed": "pnpm --filter @spendly/api db:seed",
    "db:studio": "pnpm --filter @spendly/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
