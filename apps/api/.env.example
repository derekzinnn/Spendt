# ─── Spendly API ───────────────────────────────────────────────────────────────
# Copy to apps/api/.env for local development. In production, inject these as
# environment variables (the API never requires the file to exist).

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# PostgreSQL 15+ connection string.
# Local development: a database you run yourself.
# Docker: the host is the database container's name (see docker-compose.yml).
DATABASE_URL=postgresql://spendly:spendly@localhost:5432/spendly?schema=public
# Max connections in the pool (default 10)
# DATABASE_POOL_SIZE=10

# Public origin of the web app. Web and API share one origin: Caddy routes /api/* to
# this API and everything else to the web build (Vite proxies /api in dev).
WEB_ORIGIN=http://localhost:5173

# Express "trust proxy". "loopback" when Caddy runs on the same host; use the proxy's
# IP/CIDR (or a hop count) when it runs elsewhere, e.g. inside a Docker network.
# With Caddy in its own container, "loopback" is WRONG: every request would look like it
# came from Caddy's address, so the login rate limit would be one bucket for the world.
TRUST_PROXY=loopback

# Login/register/invite attempts allowed per IP every 15 minutes (then HTTP 429)
AUTH_RATE_LIMIT=20

# ─── Postgres container (docker-compose.yml only) ─────────────────────────────
# Compose reads these to create the database; DATABASE_URL above must match them.
POSTGRES_USER=spendly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendly

# ─── Development seed (pnpm db:seed) ──────────────────────────────────────────
SEED_HOUSEHOLD_NAME=Nossa casa
SEED_OWNER_NAME=Derek
SEED_OWNER_EMAIL=eu@spendly.local
SEED_PARTNER_NAME=Parceira
SEED_PARTNER_EMAIL=parceira@spendly.local
# Both demo users get this password. Change it.
SEED_PASSWORD=123
# SEED_RESET=true
