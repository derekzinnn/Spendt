# ─── Spendly web (Vite) ────────────────────────────────────────────────────────
# Copy to apps/web/.env.local for local overrides. Only used by the dev server:
# the production build is static files and calls the API on the same origin (/api).

# Dev server port
WEB_PORT=5173

# Where the dev server forwards /api requests (the Express API)
API_PROXY_TARGET=http://localhost:3333
